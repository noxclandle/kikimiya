# ------------------------------------------------------------------
# 聴き宮 環境変数のひな形。 cp .env.example .env して書き換えてください。
# 秘密の値はコードに直接書かず、必ずここ（環境変数）から読み込みます。
# ------------------------------------------------------------------

# ---------- フロント（Next.js）から見える値。NEXT_PUBLIC_ が付くものは
#            ブラウザに露出するので、秘密の値は絶対に入れないこと ----------

# 常時起動サーバー（Socket.io + 文章メッセージAPI）の場所
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# 公開URL（Stripe の戻り先の組み立てに使う）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# お布施の受け口。Stripe で「お客様が金額を指定」の Payment Link を作って、そのURLを貼る。
# これを設定すれば、下の STRIPE_SECRET_KEY は不要（サーバーに秘密のキーを置かずに済む）。
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# ---------- 声の通り道（WebRTC） ----------

# 外から見た自分のアドレスを教えてもらう先。既定のままでよい。
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# 中継（TURN）。
#
# STUN だけでは、携帯回線や職場・学校のネットワークから来た相手と
# 音声が繋がらないことがある（対称NAT）。ずっと運用するなら用意しておくこと。
# 繋がるかどうかは /admin の「声の通り道 → 確かめる」で試せる。
#
# 提供元は udp / tcp / 443番 の複数URLを配ることが多い。
# カンマ区切りで全部並べておくと、塞がれていない経路で通る。
#   例) NEXT_PUBLIC_TURN_URLS=turn:example.com:3478?transport=udp,turn:example.com:3478?transport=tcp,turns:example.com:5349
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# 旧い書き方（ひとつだけ指定する場合）。NEXT_PUBLIC_TURN_URLS があればそちらが優先される。
NEXT_PUBLIC_TURN_URL=

# ---------- サーバー側だけで使う値（ブラウザには出ない） ----------

# ↓ここから下は、Payment Link を使わずサーバーで決済画面を作る場合だけ。
#   NEXT_PUBLIC_STRIPE_PAYMENT_LINK を設定しているなら空のままでよい。
STRIPE_SECRET_KEY=

# お布施の金額設定（JPY は最小単位が「円」なのでそのままの数値）
# 自由金額の Price をあらかじめ作ってある場合はここに（未設定なら初回に自動作成）
STRIPE_DONATION_PRICE_ID=

DONATION_CURRENCY=jpy
DONATION_PRESET_AMOUNT=1000
DONATION_MIN_AMOUNT=100
DONATION_MAX_AMOUNT=100000

# ---------- 常時起動サーバー（server/）用 ----------

SOCKET_PORT=3001


# /admin の合言葉。短いものを使う場合は、下の締め出し設定を必ず有効にしておくこと
ADMIN_PASSWORD=

# 合言葉を間違え続けたときの締め出し（回数と、締め出す時間ミリ秒）
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MS=900000

# ブラウザからの接続を許可するオリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:3000

# 文章メッセージの保存先ディレクトリ
DATA_DIR=./data

# 在室確認。この時間 信号が届かない接続は自動的に退室扱いになる
HEARTBEAT_TIMEOUT_MS=15000
HEARTBEAT_STALE_MS=8000

# 神父の待機ページを閉じた／再読み込みしたとき、離席とみなすまでの猶予
FATHER_GRACE_MS=20000

# 「返信の目安：◯日以内」の初期値（/admin から変更できる）
REPLY_ETA_DAYS=3

# 順番が来た人を待つ秒数。過ぎたら次の人に回す（/admin から変更できる）
INVITE_TIMEOUT_SECONDS=60

# 統計の日付を切り替えるタイムゾーン
STATS_TIMEZONE=Asia/Tokyo

# ---------- Supabase（リアルタイムの通り道と、手紙の保存先） ----------

# 公開してよい値。ブラウザに埋め込まれる。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 秘密の値。サーバー側（Vercelの関数）だけで使う。絶対に公開しないこと。
# RLSを無視して全データを読み書きできる鍵なので、漏れると懺悔の中身が読まれる。
SUPABASE_SECRET_KEY=

# ---------- 待機所（神父の部屋）の隠し入口 ----------
#
# ここに入れた名前でだけ待機所が開き、/admin は 404 になる。
#   例) ADMIN_PATH=k7m2q9x4v8n3b6t1w5r0 → https://example.com/k7m2q9x4v8n3b6t1w5r0
#
# 空にすると /admin がそのまま開く（手元で試すときはそれでよい）。
# **これは鍵ではなく目隠し。** URLが人目に触れれば意味を失うので、
# ADMIN_PASSWORD は必ず十分に長いものを設定すること。
ADMIN_PATH=
